{
 "name": "pigeon-newsapp",
 "version": "0.1.0",
 "private": true,
 "description": "Pigeon \u00e2\u20ac\u201d a minimalist, fact-only news app. FACT -> CONTEXT -> WEIGH-IT. Built on free primary-source ingestion + a provider-abstracted classifier (mock default, Grok-ready, inert without key).",
 "type": "module",
 "engines": {
 "node": ">=20.11"
 },
 "scripts": {
 "dev": "next dev",
 "build": "next build",
 "start": "next start",
 "typecheck": "tsc --noEmit",
 "ingest": "node --import tsx lib/ingestion/run.ts",
 "ingest:dry": "node --import tsx lib/ingestion/run.ts --dry",
 "reenrich": "node --import tsx scripts/reenrich.ts",
 "markets": "node --import tsx scripts/refresh-markets.ts",
 "overrides": "node scripts/build-overrides.mjs",
 "local:build": "node scripts/build-local.mjs",
 "local:civic": "node scripts/build-local.mjs --civic",
 "globe:data": "node scripts/build-globe-data.mjs",
 "globe:physical": "node scripts/build-globe-physical.mjs",
 "test:globe": "node tests/globe-oracle.mjs",
 "test:globe:realclick": "node tests/globe-oracle-realclick.mjs",
 "globe:county": "node scripts/build-county-packs.mjs",
 "test:globe:packs": "node tests/county-packs-oracle.mjs --rebuild",
 "oracle:freeze": "node scripts/freeze-oracle-fixtures.mjs",
 "test:oracle": "node --import tsx tests/ranking-oracle.mjs"
 },
 "dependencies": {
 "d3-geo": "^3.1.1",
 "fast-xml-parser": "4.5.1",
 "next": "^15.5.19",
 "openai": "4.104.0",
 "react": "19.0.0",
 "react-dom": "19.0.0",
 "topojson-client": "^3.1.0"
 },
 "devDependencies": {
 "@types/node": "22.10.7",
 "@types/react": "19.0.7",
 "@types/react-dom": "19.0.3",
 "d3-contour": "^4.0.2",
 "playwright": "^1.59.1",
 "pngjs": "^7.0.0",
 "shapefile": "^0.6.6",
 "tsx": "4.19.2",
 "typescript": "5.7.3"
 }
}
